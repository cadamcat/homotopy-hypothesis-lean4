import Mathlib.CategoryTheory.Subfunctor.OfSection
import HomotopyHypothesis.Blueprint.Henry.SemiSimplicial
universe u

open CategoryTheory Opposite

namespace HomotopyHypothesis.Approximation.FiniteSubcomplex

/-- The subfunctor generated by finitely many simplices is finite in each degree and bounded in
dimension. -/
theorem finiteSubfunctor_generated_by_finset (X : HomotopyHypothesis.Henry.SemiSSet.{u})
    (S : Finset (Σ n : ℕ, X.obj (Opposite.op
      (HomotopyHypothesis.Henry.SemiSimplexCategory.mk n)))) :
    ∃ Y : Subfunctor X,
      (∀ m : ℕ, (Y.obj (Opposite.op
        (HomotopyHypothesis.Henry.SemiSimplexCategory.mk m))).Finite) ∧
      (∃ N : ℕ, ∀ m : ℕ, N < m →
        Y.obj (Opposite.op (HomotopyHypothesis.Henry.SemiSimplexCategory.mk m)) = ∅) ∧
      (∀ i ∈ S, i.2 ∈ Y.obj (Opposite.op
        (HomotopyHypothesis.Henry.SemiSimplexCategory.mk i.1) )) ∧
      (∀ Z : Subfunctor X,
        (∀ i ∈ S, i.2 ∈ Z.obj (Opposite.op
          (HomotopyHypothesis.Henry.SemiSimplexCategory.mk i.1))) → Y ≤ Z) := by
  classical
  let Y : Subfunctor X := ⨆ i : S, Subfunctor.ofSection (i.1.2)
  haveI : Finite S := Finite.of_fintype _
  have hsec (m : ℕ) (i : S) :
      ((Subfunctor.ofSection (i.1.2)).obj
        (Opposite.op (HomotopyHypothesis.Henry.SemiSimplexCategory.mk m))).Finite := by
    haveI : Finite
        (SimplexCategory.mk m ⟶ SimplexCategory.mk i.1.1) := by
      apply Finite.of_injective (fun f => f.toOrderHom.toFun)
      intro f g h
      ext x
      exact congrArg Fin.val (congrFun h x)
    haveI : Finite (HomotopyHypothesis.Henry.SemiSimplexCategory.mk m ⟶
        HomotopyHypothesis.Henry.SemiSimplexCategory.mk i.1.1) := by
      exact Finite.of_injective
        (HomotopyHypothesis.Henry.SemiSimplexCategory.incl.map)
        (HomotopyHypothesis.Henry.SemiSimplexCategory.incl.map_injective)
    haveI : Finite
        (Opposite.op (HomotopyHypothesis.Henry.SemiSimplexCategory.mk i.1.1) ⟶
          Opposite.op (HomotopyHypothesis.Henry.SemiSimplexCategory.mk m)) := by
      exact Finite.of_equiv
        (HomotopyHypothesis.Henry.SemiSimplexCategory.mk m ⟶
          HomotopyHypothesis.Henry.SemiSimplexCategory.mk i.1.1)
        (CategoryTheory.opEquiv
          (Opposite.op (HomotopyHypothesis.Henry.SemiSimplexCategory.mk i.1.1))
          (Opposite.op (HomotopyHypothesis.Henry.SemiSimplexCategory.mk m))).symm
    have heq :
        (Subfunctor.ofSection (i.1.2)).obj
          (Opposite.op (HomotopyHypothesis.Henry.SemiSimplexCategory.mk m)) =
        Set.range (fun f :
          HomotopyHypothesis.Henry.SemiSimplexCategory.mk m ⟶
            HomotopyHypothesis.Henry.SemiSimplexCategory.mk i.1.1 =>
          X.map f.op i.1.2) := by
      ext y
      simp only [Subfunctor.ofSection_obj, Set.mem_ofPred_eq, Set.mem_range]
      constructor
      · rintro ⟨f, hf⟩
        exact ⟨f.unop, by simpa using hf⟩
      · rintro ⟨f, hf⟩
        exact ⟨f.op, by simpa using hf⟩
    rw [heq]
    exact Set.finite_range _
  refine ⟨Y, ?_, ?_, ?_, ?_⟩
  · intro m
    simp only [Y, Subfunctor.iSup_obj]
    exact Set.finite_iUnion (hsec m)
  · let N := S.sup fun i => i.1
    refine ⟨N, fun m hm => ?_⟩
    have hEmpty :
        Y.obj (Opposite.op (HomotopyHypothesis.Henry.SemiSimplexCategory.mk m)) = ∅ := by
      simp only [Y, Subfunctor.iSup_obj]
      apply Set.iUnion_eq_empty.mpr
      intro i
      apply Set.eq_empty_iff_forall_notMem.mpr
      intro y hy
      have hface : ∃ f :
          HomotopyHypothesis.Henry.SemiSimplexCategory.mk m ⟶
            HomotopyHypothesis.Henry.SemiSimplexCategory.mk i.1.1,
          X.map f.op i.1.2 = y := by
        have hh : ∃ f :
            Opposite.op (HomotopyHypothesis.Henry.SemiSimplexCategory.mk i.1.1) ⟶
              Opposite.op (HomotopyHypothesis.Henry.SemiSimplexCategory.mk m),
            X.map f i.1.2 = y := by
          simpa [Subfunctor.ofSection_obj] using hy
        rcases hh with ⟨f, hf⟩
        exact ⟨f.unop, by simpa using hf⟩
      obtain ⟨f, _⟩ := hface
      have hlen : m ≤ i.1.1 := by
        letI : Mono
            (HomotopyHypothesis.Henry.SemiSimplexCategory.incl.map f) := f.property
        simpa [HomotopyHypothesis.Henry.SemiSimplexCategory.mk] using
          (SimplexCategory.len_le_of_mono
            (HomotopyHypothesis.Henry.SemiSimplexCategory.incl.map f))
      have hNi : i.1.1 ≤ N := Finset.le_sup (f := fun j => j.1) i.2
      omega
    exact hEmpty
  · intro i hi
    simp only [Y, Subfunctor.iSup_obj]
    exact Set.mem_iUnion.mpr
      ⟨⟨i, hi⟩, Subfunctor.mem_ofSection_obj i.2⟩
  · intro Z hgen
    dsimp [Y]
    apply iSup_le
    intro i
    rw [Subfunctor.ofSection_le_iff]
    exact hgen i.1 i.2

end HomotopyHypothesis.Approximation.FiniteSubcomplex
