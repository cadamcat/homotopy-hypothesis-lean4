import HomotopyHypothesis.Blueprint.Henry.Approximation
import HomotopyHypothesis.Blueprint.Henry.Constructions
import HomotopyHypothesis.Blueprint.Henry.SemiModel
import HomotopyHypothesis.Blueprint.Henry.SemiSimplicial
import HomotopyHypothesis.Approximation.Anodyne.StdSimplex
/-!
# Free extensions of algebraic semi-simplicial Kan complexes

Let `X` be an algebraic semi-simplicial Kan complex and `m : X ⟶ K` a monomorphism of
semi-simplicial sets. We construct the algebraic Kan complex freely generated by `K` relative to
`X`: starting from `K`, freely add a filler for every horn that does not already lie in the previous
stage (horns of `X` keep the fillers of `X`), and take the union of the stages (H:2891–2894). The
inclusion of `K` is a sequential composite of pushouts of coproducts of horn inclusions.

Applied to `K = X ⊔_{∂Δ_n} Δ_n`, this constructs the free cell attachments of algebraic Kan
complexes along arbitrary boundary maps.
-/

universe u

open CategoryTheory Limits Opposite MorphismProperty

namespace HomotopyHypothesis.Realization.SemisimplicialComparison

open HomotopyHypothesis.Henry

/-- Indices `(n, k)` of the horn inclusions `Λ^{n+1}_k ↪ Δ_{n+1}`. -/
abbrev HornIdx : Type := Σ n : ℕ, Fin (n + 2)

/-- The horn `Λ^{n+1}_k`. -/
abbrev hornObj (p : HornIdx) : SemiSSet.{u} := (SemiSSet.horn.{u} (p.1 + 1) p.2).toFunctor

/-- The simplex `Δ_{n+1}`. -/
abbrev simplexObj (p : HornIdx) : SemiSSet.{u} :=
  SemiSSet.stdSimplex.{u}.obj (Henry.SemiSimplexCategory.mk (p.1 + 1))

/-- The horn inclusion `Λ^{n+1}_k ↪ Δ_{n+1}`. -/
abbrev hornι (p : HornIdx) : hornObj.{u} p ⟶ simplexObj.{u} p :=
  (SemiSSet.horn.{u} (p.1 + 1) p.2).ι

/-- The horns of `B` that do not factor through `a : A ⟶ B`. -/
abbrev NewHorn {A B : SemiSSet.{u}} (a : A ⟶ B) : Type u :=
  { q : Σ p : HornIdx, hornObj.{u} p ⟶ B // ¬ ∃ h, h ≫ a = q.2 }

section Step

variable {A B : SemiSSet.{u}} (a : A ⟶ B)

/-- The coproduct of the new horns, mapped to `B`. -/
noncomputable abbrev stepTop : (∐ fun q : NewHorn a => hornObj.{u} q.1.1) ⟶ B :=
  Sigma.desc fun q => q.1.2

/-- The coproduct of the horn inclusions indexed by the new horns. -/
noncomputable abbrev stepLeft :
    (∐ fun q : NewHorn a => hornObj.{u} q.1.1) ⟶ ∐ fun q : NewHorn a => simplexObj.{u} q.1.1 :=
  Limits.Sigma.map (fun q : NewHorn a => hornι.{u} q.1.1)

/-- One stage of the free completion: fill every new horn of `B`. -/
noncomputable abbrev stepObj : SemiSSet.{u} := pushout (stepTop a) (stepLeft a)

/-- The inclusion of `B` into the next stage. -/
noncomputable abbrev stepInl : B ⟶ stepObj a := pushout.inl _ _

/-- The filler added for a new horn. -/
noncomputable def stepCell (q : NewHorn a) : simplexObj.{u} q.1.1 ⟶ stepObj a :=
  Sigma.ι (fun q : NewHorn a => simplexObj.{u} q.1.1) q ≫ pushout.inr _ _

theorem hornι_stepCell (q : NewHorn a) : hornι q.1.1 ≫ stepCell a q = q.1.2 ≫ stepInl a := by
  have := Sigma.ι (fun q : NewHorn a => hornObj.{u} q.1.1) q ≫=
    pushout.condition (f := stepTop a) (g := stepLeft a)
  simp only [stepTop, stepLeft, Sigma.ι_comp_desc_assoc, Limits.Sigma.ι_map_assoc] at this
  simp only [stepCell, stepInl, this]

theorem stepLeft_mem : (MorphismProperty.coproducts.{u} (MorphismProperty.ofHoms
    (fun p : HornIdx => hornι.{u} p))) (stepLeft a) :=
  colimitsOfShape_le_coproducts _ (NewHorn a) _
    (colimitsOfShape_colimMap (Discrete.natTrans
      (F := Discrete.functor fun q : NewHorn a => hornObj.{u} q.1.1)
      (G := Discrete.functor fun q : NewHorn a => simplexObj.{u} q.1.1)
      fun j => hornι.{u} j.as.1.1) (fun j => MorphismProperty.ofHoms.mk j.as.1.1))

instance mono_stepLeft : Mono (stepLeft a) := by
  have : (monomorphisms SemiSSet.{u}) (colimMap (Discrete.natTrans
      (F := Discrete.functor fun q : NewHorn a => hornObj.{u} q.1.1)
      (G := Discrete.functor fun q : NewHorn a => simplexObj.{u} q.1.1)
      fun j => hornι.{u} j.as.1.1)) :=
    MorphismProperty.colimMap (W := monomorphisms SemiSSet.{u}) _
      (fun j => (inferInstance : Mono (hornι.{u} j.as.1.1)))
  exact (monomorphisms.iff _).1 this

instance mono_stepInl : Mono (stepInl a) := by
  rw [NatTrans.mono_iff_mono_app]
  intro d
  have sq := (IsPushout.of_hasPushout (stepTop a) (stepLeft a)).map ((evaluation _ _).obj d)
  have : Mono ((stepLeft a).app d) := inferInstance
  exact (monomorphisms (Type u)).of_isPushout sq this

theorem stepInl_mem : (MorphismProperty.coproducts.{u} (MorphismProperty.ofHoms
    (fun p : HornIdx => hornι.{u} p))).pushouts (stepInl a) :=
  pushouts_mk _ (IsPushout.of_hasPushout _ _) (stepLeft_mem a)

/-- Maps out of the next stage: a map out of `B` together with fillers for the new horns. -/
noncomputable def stepDesc {Z : SemiSSet.{u}} (g : B ⟶ Z)
    (c : ∀ q : NewHorn a, simplexObj.{u} q.1.1 ⟶ Z)
    (hc : ∀ q : NewHorn a, hornι q.1.1 ≫ c q = q.1.2 ≫ g) : stepObj a ⟶ Z :=
  pushout.desc g (Sigma.desc c) (Sigma.hom_ext _ _ fun q => by simp [stepTop, stepLeft, hc])

@[reassoc (attr := simp)]
theorem stepInl_stepDesc {Z : SemiSSet.{u}} (g : B ⟶ Z)
    (c : ∀ q : NewHorn a, simplexObj.{u} q.1.1 ⟶ Z)
    (hc : ∀ q : NewHorn a, hornι q.1.1 ≫ c q = q.1.2 ≫ g) :
    stepInl a ≫ stepDesc a g c hc = g := pushout.inl_desc _ _ _

@[reassoc (attr := simp)]
theorem stepCell_stepDesc {Z : SemiSSet.{u}} (g : B ⟶ Z)
    (c : ∀ q : NewHorn a, simplexObj.{u} q.1.1 ⟶ Z)
    (hc : ∀ q : NewHorn a, hornι q.1.1 ≫ c q = q.1.2 ≫ g) (q : NewHorn a) :
    stepCell a q ≫ stepDesc a g c hc = c q := by
  rw [stepCell, stepDesc, Category.assoc, pushout.inr_desc, Sigma.ι_comp_desc]

theorem step_hom_ext {Z : SemiSSet.{u}} {f g : stepObj a ⟶ Z} (h₁ : stepInl a ≫ f = stepInl a ≫ g)
    (h₂ : ∀ q, stepCell a q ≫ f = stepCell a q ≫ g) : f = g :=
  pushout.hom_ext h₁ (Sigma.hom_ext _ _ fun q => by simpa [stepCell] using h₂ q)

end Step

section Factor

/-- A map from a finite semi-simplicial set into a sequential colimit with monomorphic legs
factors through some stage. -/
theorem exists_factor_of_isFinite {F : ℕ ⥤ SemiSSet.{u}} (hF : ∀ i, Mono (colimit.ι F i))
    {S : SemiSSet.{u}} (hS : S.IsFinite) (h : S ⟶ colimit F) :
    ∃ (i : ℕ) (h' : S ⟶ F.obj i), h' ≫ colimit.ι F i = h := by
  have rep : ∀ (d : Henry.SemiSimplexCategoryᵒᵖ) (s : S.obj d),
      ∃ (i : ℕ) (x : (F.obj i).obj d), (colimit.ι F i).app d x = h.app d s := by
    intro d s
    obtain ⟨i, x, hx⟩ := Types.jointly_surjective_of_isColimit
      (isColimitOfPreserves ((evaluation _ _).obj d) (colimit.isColimit F)) (h.app d s)
    exact ⟨i, x, hx⟩
  obtain ⟨hfin, N, hN⟩ := hS
  let T := Σ p : Fin (N + 1), S.obj (op (Henry.SemiSimplexCategory.mk p))
  have : Finite T := by
    have := fun p : Fin (N + 1) => hfin p
    infer_instance
  let idx : T → ℕ := fun t => (rep _ t.2).choose
  obtain ⟨M, hM⟩ : ∃ M, ∀ t, idx t ≤ M := by
    obtain ⟨M, hM⟩ := (Set.finite_range idx).bddAbove
    exact ⟨M, fun t => hM ⟨t, rfl⟩⟩
  have rep' : ∀ (d : Henry.SemiSimplexCategoryᵒᵖ) (s : S.obj d),
      ∃ x : (F.obj M).obj d, (colimit.ι F M).app d x = h.app d s := by
    intro d s
    by_cases hd : d.unop.obj.len ≤ N
    · let t : T := ⟨⟨d.unop.obj.len, Nat.lt_succ_of_le hd⟩, s⟩
      obtain ⟨x, hx⟩ := (rep _ t.2).choose_spec
      refine ⟨(F.map (homOfLE (hM t))).app d x, ?_⟩
      rw [← hx]
      exact congrArg (fun k => k.app d x) (colimit.w F (homOfLE (hM t)))
    · exact ((hN d.unop.obj.len (by omega)).false s).elim
  have inj : ∀ d, Function.Injective ((colimit.ι F M).app d) := fun d => by
    rw [← mono_iff_injective]
    exact (NatTrans.mono_iff_mono_app _).1 (hF M) d
  refine ⟨M, { app := fun d => TypeCat.ofHom (fun s => (rep' d s).choose), naturality := ?_ }, ?_⟩
  · intro d d' f
    ext s
    apply inj
    change (colimit.ι F M).app d' ((rep' d' (S.map f s)).choose) =
      (colimit.ι F M).app d' ((F.obj M).map f ((rep' d s).choose))
    have e := ConcreteCategory.congr_hom ((colimit.ι F M).naturality f) (rep' d s).choose
    simp only [types_comp_apply] at e
    rw [(rep' d' _).choose_spec, e, (rep' d s).choose_spec]
    exact (ConcreteCategory.congr_hom (h.naturality f) s)
  · ext d s
    exact (rep' d s).choose_spec

end Factor

section Free

variable (X : AlgKan.{u}) {K : SemiSSet.{u}} (m : X.X ⟶ K)

/-- The stages of the free completion: `(previous stage, stage, inclusion)`. -/
@[reducible] noncomputable def stage : ℕ → Σ (A B : SemiSSet.{u}), A ⟶ B
  | 0 => ⟨X.X, K, m⟩
  | i + 1 => ⟨(stage i).2.1, stepObj (stage i).2.2, stepInl (stage i).2.2⟩

/-- The `i`-th stage (`K` for `i = 0`). -/
noncomputable abbrev P (i : ℕ) : SemiSSet.{u} := (stage X m i).2.1

/-- The inclusion of the previous stage (of `X` for `i = 0`). -/
noncomputable abbrev prev (i : ℕ) : (stage X m i).1 ⟶ P X m i := (stage X m i).2.2

/-- The inclusion of a stage into the next one. -/
noncomputable abbrev inc (i : ℕ) : P X m i ⟶ P X m (i + 1) := prev X m (i + 1)

/-- The sequence of stages. -/
noncomputable abbrev seq : ℕ ⥤ SemiSSet.{u} := Functor.ofSequence (inc X m)

/-- The underlying semi-simplicial set of the free completion. -/
noncomputable abbrev freeX : SemiSSet.{u} := colimit (seq X m)

/-- The inclusion of a stage. -/
noncomputable abbrev cc (i : ℕ) : P X m i ⟶ freeX X m := colimit.ι (seq X m) i

@[reassoc (attr := simp)]
theorem inc_cc (i : ℕ) : inc X m i ≫ cc X m (i + 1) = cc X m i := by
  have := colimit.w (seq X m) (homOfLE (Nat.le_add_right i 1))
  rwa [Functor.ofSequence_map_homOfLE_succ] at this

theorem inc_mem (i : ℕ) : (MorphismProperty.coproducts.{u} (MorphismProperty.ofHoms
    (fun p : HornIdx => hornι.{u} p))).pushouts (inc X m i) :=
  stepInl_mem _

/-- The inclusion of `K` is a sequential composite of pushouts of coproducts of horn
inclusions. -/
noncomputable def ccComp : (MorphismProperty.coproducts.{u} (MorphismProperty.ofHoms
    (fun p : HornIdx => hornι.{u} p))).pushouts.TransfiniteCompositionOfShape ℕ (cc X m 0) where
  F := seq X m
  isoBot := Iso.refl _
  incl := (colimit.cocone (seq X m)).ι
  isColimit := colimit.isColimit _
  fac := by simp; rfl
  map_mem j _ := by
    have h : ∀ (k : ℕ) (hk : k = j + 1) (φ : j ⟶ k), (MorphismProperty.coproducts.{u}
        (MorphismProperty.ofHoms (fun p : HornIdx => hornι.{u} p))).pushouts ((seq X m).map φ) := by
      rintro k rfl φ
      obtain rfl : φ = homOfLE (Nat.le_add_right j 1) := rfl
      rw [Functor.ofSequence_map_homOfLE_succ]
      exact inc_mem X m j
    exact h _ (Order.succ_eq_add_one j) _

theorem cc_zero_mem : MorphismProperty.transfiniteCompositions.{u}
    (MorphismProperty.coproducts.{u} (MorphismProperty.ofHoms
      (fun p : HornIdx => hornι.{u} p))).pushouts (cc X m 0) :=
  MorphismProperty.transfiniteCompositionsOfShape_le_transfiniteCompositions _ _ _
    ((ccComp X m).ofOrderIso (orderIsoShrink.{u} ℕ).symm).mem

variable [Mono m]

instance mono_prev (i : ℕ) : Mono (prev X m i) := by
  cases i with
  | zero => exact (inferInstance : Mono m)
  | succ i => exact mono_stepInl _

/-- The stage inclusions as a transfinite composition of monomorphisms. -/
noncomputable def ccMonoComp :
    (monomorphisms SemiSSet.{u}).TransfiniteCompositionOfShape ℕ (cc X m 0) where
  F := seq X m
  isoBot := Iso.refl _
  incl := (colimit.cocone (seq X m)).ι
  isColimit := colimit.isColimit _
  fac := by simp; rfl
  map_mem j _ := by
    have h : ∀ (k : ℕ) (hk : k = j + 1) (φ : j ⟶ k),
        (monomorphisms SemiSSet.{u}) ((seq X m).map φ) := by
      rintro k rfl φ
      obtain rfl : φ = homOfLE (Nat.le_add_right j 1) := rfl
      rw [Functor.ofSequence_map_homOfLE_succ]
      exact (inferInstance : Mono (prev X m (j + 1)))
    exact h _ (Order.succ_eq_add_one j) _

instance mono_cc (i : ℕ) : Mono (cc X m i) := by
  let _ : OrderBot (Set.Ici i) := Set.Ici.orderBot
  exact (monomorphisms.iff _).1 ((monomorphisms SemiSSet.{u}).transfiniteCompositionsOfShape_le
    (Set.Ici i) _ ((ccMonoComp X m).ici i).mem)

/-- The composite inclusion of the `i`-th stage into the `(i + k)`-th. -/
noncomputable def incs (i : ℕ) : ∀ k : ℕ, P X m i ⟶ P X m (i + k)
  | 0 => 𝟙 _
  | k + 1 => incs i k ≫ inc X m (i + k)

omit [Mono m] in
@[reassoc (attr := simp)]
theorem incs_cc (i k : ℕ) : incs X m i k ≫ cc X m (i + k) = cc X m i := by
  induction k with
  | zero => exact Category.id_comp _
  | succ k ih =>
    change (incs X m i k ≫ inc X m (i + k)) ≫ cc X m (i + k + 1) = _
    rw [Category.assoc, inc_cc, ih]

open Classical in
/-- Fillers of horns factoring through the `i`-th stage. -/
noncomputable def fillAt : ∀ (i : ℕ) (p : HornIdx), (hornObj.{u} p ⟶ P X m i) →
    (simplexObj.{u} p ⟶ freeX X m)
  | 0, p, h => if hn : ∃ h', h' ≫ prev X m 0 = h then
      X.fill p.1 p.2 hn.choose ≫ m ≫ cc X m 0
    else stepCell (prev X m 0) ⟨⟨p, h⟩, hn⟩ ≫ cc X m 1
  | i + 1, p, h => if hn : ∃ h', h' ≫ prev X m (i + 1) = h then
      fillAt i p hn.choose
    else stepCell (prev X m (i + 1)) ⟨⟨p, h⟩, hn⟩ ≫ cc X m (i + 2)

theorem fillAt_new (i : ℕ) (p : HornIdx) (h : hornObj.{u} p ⟶ P X m i)
    (hn : ¬ ∃ h', h' ≫ prev X m i = h) :
    fillAt X m i p h = stepCell (prev X m i) ⟨⟨p, h⟩, hn⟩ ≫ cc X m (i + 1) := by
  cases i with
  | zero => rw [fillAt, dif_neg hn]
  | succ i => rw [fillAt, dif_neg hn]

theorem fillAt_zero_old (p : HornIdx) (h : hornObj.{u} p ⟶ X.X) :
    fillAt X m 0 p (h ≫ prev X m 0) = X.fill p.1 p.2 h ≫ m ≫ cc X m 0 := by
  have hn : ∃ h', h' ≫ prev X m 0 = h ≫ prev X m 0 := ⟨h, rfl⟩
  rw [fillAt, dif_pos hn]
  have : hn.choose = h := (cancel_mono m).1 hn.choose_spec
  rw [this]

theorem fillAt_inc (i : ℕ) (p : HornIdx) (h : hornObj.{u} p ⟶ P X m i) :
    fillAt X m (i + 1) p (h ≫ inc X m i) = fillAt X m i p h := by
  have hn : ∃ h', h' ≫ prev X m (i + 1) = h ≫ inc X m i := ⟨h, rfl⟩
  rw [fillAt, dif_pos hn]
  have : hn.choose = h := (cancel_mono (inc X m i)).1 hn.choose_spec
  rw [this]

theorem fillAt_incs (i k : ℕ) (p : HornIdx) (h : hornObj.{u} p ⟶ P X m i) :
    fillAt X m (i + k) p (h ≫ incs X m i k) = fillAt X m i p h := by
  induction k with
  | zero => exact congrArg (fillAt X m i p) (Category.comp_id h)
  | succ k ih =>
    change fillAt X m (i + k + 1) p (h ≫ incs X m i k ≫ inc X m (i + k)) = _
    rw [← Category.assoc, fillAt_inc, ih]

theorem fillAt_eq (i j : ℕ) (p : HornIdx) (h : hornObj.{u} p ⟶ P X m i)
    (h' : hornObj.{u} p ⟶ P X m j) (e : h ≫ cc X m i = h' ≫ cc X m j) :
    fillAt X m i p h = fillAt X m j p h' := by
  wlog hij : i ≤ j generalizing i j
  · exact (this j i h' h e.symm (by omega)).symm
  obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hij
  rw [← fillAt_incs X m i k p h]
  congr 1
  apply (cancel_mono (cc X m (i + k))).1
  rw [Category.assoc, incs_cc, e]

theorem hornι_fillAt (i : ℕ) (p : HornIdx) (h : hornObj.{u} p ⟶ P X m i) :
    hornι p ≫ fillAt X m i p h = h ≫ cc X m i := by
  induction i with
  | zero =>
    by_cases hn : ∃ h', h' ≫ prev X m 0 = h
    · obtain ⟨h', rfl⟩ := hn
      rw [fillAt_zero_old, ← Category.assoc, X.fill_spec]
      rfl
    · rw [fillAt_new X m 0 p h hn]
      rw [← Category.assoc, hornι_stepCell (prev X m 0) ⟨⟨p, h⟩, hn⟩, Category.assoc]
      exact congrArg (h ≫ ·) (inc_cc X m 0)
  | succ i ih =>
    by_cases hn : ∃ h', h' ≫ prev X m (i + 1) = h
    · obtain ⟨h', rfl⟩ := hn
      rw [fillAt_inc, ih, Category.assoc]
      exact congrArg (h' ≫ ·) (inc_cc X m i).symm
    · rw [fillAt_new X m (i + 1) p h hn]
      rw [← Category.assoc, hornι_stepCell (prev X m (i + 1)) ⟨⟨p, h⟩, hn⟩, Category.assoc]
      exact congrArg (h ≫ ·) (inc_cc X m (i + 1))

theorem exists_factor (p : HornIdx) (h : hornObj.{u} p ⟶ freeX X m) :
    ∃ (i : ℕ) (h' : hornObj.{u} p ⟶ P X m i), h' ≫ cc X m i = h := by
  have hfin : (hornObj.{u} p).IsFinite := by
    obtain ⟨hf, N, hN⟩ := Approximation.Anodyne.stdSimplex_isFinite_proof.{u} (p.1 + 1)
    refine ⟨fun n => ?_, N, fun n hn => ?_⟩
    · have := hf n
      exact Subtype.finite
    · have := hN n hn
      exact ⟨fun s => this.false s.1⟩
  exact exists_factor_of_isFinite (fun i => mono_cc X m i) hfin h

/-- The chosen filler of a horn of the free completion. -/
noncomputable def freeFill (p : HornIdx) (h : hornObj.{u} p ⟶ freeX X m) :
    simplexObj.{u} p ⟶ freeX X m :=
  fillAt X m (exists_factor X m p h).choose p (exists_factor X m p h).choose_spec.choose

theorem freeFill_eq (p : HornIdx) (i : ℕ) (h' : hornObj.{u} p ⟶ P X m i) :
    freeFill X m p (h' ≫ cc X m i) = fillAt X m i p h' :=
  fillAt_eq X m _ _ _ _ _ (exists_factor X m p _).choose_spec.choose_spec

/-- The algebraic Kan complex freely generated by `K` relative to `X`. -/
noncomputable abbrev freeKan : AlgKan.{u} where
  X := freeX X m
  fill n k h := freeFill X m ⟨n, k⟩ h
  fill_spec n k h := by
    obtain ⟨i, h', rfl⟩ := exists_factor X m ⟨n, k⟩ h
    exact (congrArg (hornι _ ≫ ·) (freeFill_eq X m ⟨n, k⟩ i h')).trans (hornι_fillAt X m i _ h')

/-- The inclusion of `K`. -/
noncomputable abbrev freeι : K ⟶ (freeKan X m).X := cc X m 0

/-- The map of algebraic Kan complexes from `X`. -/
noncomputable def freeJ : X ⟶ freeKan X m where
  hom := m ≫ cc X m 0
  fill_hom n k h := by
    have e := freeFill_eq X m ⟨n, k⟩ 0 (h ≫ prev X m 0)
    rw [fillAt_zero_old] at e
    change X.fill n k h ≫ m ≫ cc X m 0 = freeFill X m ⟨n, k⟩ ((h ≫ prev X m 0) ≫ cc X m 0)
    rw [e]

section Universal

variable (Z : AlgKan.{u}) (g : X ⟶ Z) (z : K ⟶ Z.X)

/-- The maps out of the stages determined by `z` and the fillers of `Z`. -/
noncomputable def zSeq : ∀ i : ℕ, P X m i ⟶ Z.X
  | 0 => z
  | i + 1 => stepDesc (prev X m i) (zSeq i)
      (fun q => Z.fill q.1.1.1 q.1.1.2 (q.1.2 ≫ zSeq i)) (fun q => Z.fill_spec _ _ _)

omit [Mono m] in
@[reassoc (attr := simp)]
theorem inc_zSeq (i : ℕ) : inc X m i ≫ zSeq X m Z z (i + 1) = zSeq X m Z z i :=
  stepInl_stepDesc _ _ _ _

omit [Mono m] in
theorem stepCell_zSeq (i : ℕ) (q : NewHorn (prev X m i)) :
    stepCell (prev X m i) q ≫ zSeq X m Z z (i + 1) = Z.fill q.1.1.1 q.1.1.2 (q.1.2 ≫ zSeq X m Z z i) :=
  stepCell_stepDesc _ _ _ _ _

/-- The induced map out of the free completion. -/
noncomputable def zInf : freeX X m ⟶ Z.X :=
  colimit.desc (seq X m) (Cocone.mk Z.X (NatTrans.ofSequence (zSeq X m Z z)
    (fun i => by
      simp only [Functor.const_obj_map, Functor.ofSequence_map_homOfLE_succ, Category.comp_id]
      exact inc_zSeq X m Z z i)))

omit [Mono m] in
@[reassoc (attr := simp)]
theorem cc_zInf (i : ℕ) : cc X m i ≫ zInf X m Z z = zSeq X m Z z i :=
  colimit.ι_desc _ _

variable {Z g z}

theorem fillAt_zInf (hz : m ≫ z = g.hom) (i : ℕ) (p : HornIdx) (h : hornObj.{u} p ⟶ P X m i) :
    fillAt X m i p h ≫ zInf X m Z z = Z.fill p.1 p.2 (h ≫ zSeq X m Z z i) := by
  induction i with
  | zero =>
    by_cases hn : ∃ h', h' ≫ prev X m 0 = h
    · obtain ⟨h', rfl⟩ := hn
      rw [fillAt_zero_old]
      simp only [Category.assoc, cc_zInf]
      change X.fill p.1 p.2 h' ≫ m ≫ z = Z.fill p.1 p.2 ((h' ≫ m) ≫ z)
      rw [hz, Category.assoc, hz, g.fill_hom]
    · rw [fillAt_new X m 0 p h hn, Category.assoc, cc_zInf, stepCell_zSeq]
  | succ i ih =>
    by_cases hn : ∃ h', h' ≫ prev X m (i + 1) = h
    · obtain ⟨h', rfl⟩ := hn
      rw [fillAt_inc, ih, Category.assoc, inc_zSeq]
    · rw [fillAt_new X m (i + 1) p h hn, Category.assoc, cc_zInf, stepCell_zSeq]

/-- The map of algebraic Kan complexes induced by `g` and `z`. -/
noncomputable def freeDesc (hz : m ≫ z = g.hom) : freeKan X m ⟶ Z where
  hom := zInf X m Z z
  fill_hom n k h := by
    obtain ⟨i, h', rfl⟩ := exists_factor X m ⟨n, k⟩ h
    change freeFill X m ⟨n, k⟩ (h' ≫ cc X m i) ≫ _ = _
    rw [freeFill_eq, fillAt_zInf X m hz, Category.assoc, cc_zInf]

theorem freeι_freeDesc (hz : m ≫ z = g.hom) : freeι X m ≫ (freeDesc X m hz).hom = z :=
  cc_zInf X m Z z 0

theorem freeJ_freeDesc (hz : m ≫ z = g.hom) : freeJ X m ≫ freeDesc X m hz = g := by
  apply AlgKan.Hom.ext
  change m ≫ cc X m 0 ≫ zInf X m Z z = g.hom
  rw [cc_zInf]
  exact hz

theorem freeKan_hom_ext {f f' : freeKan X m ⟶ Z} (h : freeι X m ≫ f.hom = freeι X m ≫ f'.hom) :
    f = f' := by
  have key : ∀ i, cc X m i ≫ f.hom = cc X m i ≫ f'.hom := by
    intro i
    induction i with
    | zero => exact h
    | succ i ih =>
      apply step_hom_ext
      · change inc X m i ≫ cc X m (i + 1) ≫ f.hom = inc X m i ≫ cc X m (i + 1) ≫ f'.hom
        rw [inc_cc_assoc, inc_cc_assoc, ih]
      · intro q
        have hq : stepCell (prev X m i) q ≫ cc X m (i + 1) =
            (freeKan X m).fill q.1.1.1 q.1.1.2 (q.1.2 ≫ cc X m i) := by
          change _ = freeFill X m q.1.1 _
          rw [freeFill_eq, fillAt_new X m i q.1.1 q.1.2 q.2]
        rw [← Category.assoc, ← Category.assoc, hq, f.fill_hom, f'.fill_hom, Category.assoc,
          Category.assoc, ih]
  apply AlgKan.Hom.ext
  exact colimit.hom_ext key

theorem freeKan_universal (hz : m ≫ z = g.hom) :
    ∃! g' : freeKan X m ⟶ Z, freeι X m ≫ g'.hom = z :=
  ⟨freeDesc X m hz, freeι_freeDesc X m hz, fun g'' h =>
    freeKan_hom_ext X m (h.trans (freeι_freeDesc X m hz).symm)⟩

end Universal

end Free

end HomotopyHypothesis.Realization.SemisimplicialComparison
