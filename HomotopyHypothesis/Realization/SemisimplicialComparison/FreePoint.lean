import HomotopyHypothesis.Blueprint.Henry.SemiSimplicial
import HomotopyHypothesis.Realization.SemisimplicialComparison.CDeltaFacts
/-!
# The free point of `C^Δ`

The algebraic Kan complex freely generated by `Δ₀` is finitely cellular.
-/

universe u

namespace HomotopyHypothesis.Realization.SemisimplicialComparison

open HomotopyHypothesis.Henry

/-- The free algebraic Kan complex on `Δ₀` lies in `C^Δ`. -/
theorem exists_free_point_proof :
    ∃ (o : CDelta.{u}) (η : SemiSSet.stdSimplex.obj (Henry.SemiSimplexCategory.mk 0) ⟶ o.obj.X),
      o.obj.IsFreeOn η :=
  exists_free_simplex 0

end HomotopyHypothesis.Realization.SemisimplicialComparison
