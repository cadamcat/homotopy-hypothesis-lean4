import HomotopyHypothesis.Blueprint.Henry.SemiSimplicial
import HomotopyHypothesis.Approximation.TopSimplex.TopSimplex
import HomotopyHypothesis.Realization.SemisimplicialComparison.CellAttach
import HomotopyHypothesis.Realization.SemisimplicialComparison.FreeKan
import HomotopyHypothesis.Realization.SemisimplicialComparison.TopSimplex
/-!
# Initial objects, pushouts and free objects in `C^Δ`

* The empty algebraic Kan complex is initial and finitely cellular; initial objects of `C^Δ` are
  initial algebraic Kan complexes, with empty underlying semi-simplicial sets.
* Pushouts along cofibrations of `C^Δ` are pushouts of algebraic Kan complexes.
* For every semi-simplicial subset `S` of a standard simplex there is an object of `C^Δ` freely
  generated by `S`; in particular free objects on `∂Δ_n` and `Δ_n` exist in `C^Δ`.
-/

universe u

open CategoryTheory Limits Opposite MorphismProperty HomotopicalAlgebra

namespace HomotopyHypothesis.Realization.SemisimplicialComparison

open HomotopyHypothesis.Henry

section Empty

/-- The vertex `k` of the horn `Λ^{n+1}_k`. -/
def hornVertex (n : ℕ) (k : Fin (n + 2)) :
    (SemiSSet.horn.{u} (n + 1) k).toFunctor.obj (op (Henry.SemiSimplexCategory.mk 0)) :=
  ⟨ULift.up ⟨SimplexCategory.const _ _ k, (monomorphisms.iff _).2 (by
      rw [SimplexCategory.mono_iff_injective]
      intro x y _
      exact Subsingleton.elim (α := Fin 1) x y)⟩,
    ⟨k.succAbove 0, Fin.succAbove_ne k 0, by
      rintro ⟨x, hx⟩
      exact Fin.succAbove_ne k 0 hx.symm⟩⟩

/-- The empty semi-simplicial set. -/
abbrev emptyX : SemiSSet.{u} := (Functor.const _).obj PEmpty.{u + 1}

/-- The empty algebraic Kan complex. -/
def emptyKan : AlgKan.{u} where
  X := emptyX
  fill n k h := ((h.app _ (hornVertex n k)) : PEmpty).elim
  fill_spec n k h := ((h.app _ (hornVertex n k)) : PEmpty).elim

/-- The map out of the empty semi-simplicial set. -/
def fromEmptyX (Y : SemiSSet.{u}) : emptyX.{u} ⟶ Y where
  app _ := TypeCat.ofHom PEmpty.elim
  naturality _ _ _ := by ext x; exact x.elim

theorem emptyX_hom_ext {Y : SemiSSet.{u}} (f g : emptyX.{u} ⟶ Y) : f = g := by
  ext _ x; exact x.elim

/-- The empty algebraic Kan complex is initial. -/
def isInitial_emptyKan : IsInitial emptyKan.{u} :=
  IsInitial.ofUniqueHom (fun Z => ⟨fromEmptyX Z.X, fun n k h =>
      ((h.app _ (hornVertex n k)) : PEmpty).elim⟩)
    (fun _ _ => AlgKan.Hom.ext (emptyX_hom_ext _ _))

theorem emptyKan_isFinitelyCellular : AlgKan.IsFinitelyCellular emptyKan.{u} :=
  .initial _ ⟨isInitial_emptyKan⟩

/-- The empty object of `C^Δ`. -/
def emptyC : CDelta.{u} := ⟨emptyKan, emptyKan_isFinitelyCellular⟩

/-- The empty object of `C^Δ` is initial. -/
def isInitial_emptyC : IsInitial emptyC.{u} :=
  IsInitial.ofUniqueHom (fun Z => ObjectProperty.homMk (isInitial_emptyKan.to Z.obj))
    (fun _ _ => ObjectProperty.hom_ext _ (isInitial_emptyKan.hom_ext _ _))

/-- An initial object of `C^Δ` is an initial algebraic Kan complex. -/
noncomputable def isInitial_obj_of_isInitial {I : CDelta.{u}} (hI : IsInitial I) :
    IsInitial I.obj :=
  isInitial_emptyKan.ofIso ((ObjectProperty.ι _).mapIso (isInitial_emptyC.uniqueUpToIso hI))

theorem isEmpty_of_isInitial {X : AlgKan.{u}} (hX : IsInitial X) (d) : IsEmpty (X.X.obj d) :=
  ⟨fun x => (((hX.to emptyKan).hom.app d x) : PEmpty).elim⟩

end Empty

section Pushouts

/-- Pushouts along cell attachments and isomorphisms. -/
theorem exists_isPushout_of_cell {A B : AlgKan.{u}} (i : A ⟶ B)
    (hi : AlgKan.IsCellAttachment i ∨ MorphismProperty.isomorphisms AlgKan.{u} i) {X : AlgKan.{u}} (f : A ⟶ X) :
    ∃ (P : AlgKan.{u}) (k : B ⟶ P) (j : X ⟶ P), IsPushout i f k j ∧
      (AlgKan.IsFinitelyCellular X → AlgKan.IsFinitelyCellular P) ∧ AlgKan.cellularMaps j := by
  rcases hi with hi | hi
  · let d := AlgKan.IsCellAttachment.data (j := i) hi
    let P := attach X d.n (d.a ≫ f.hom)
    have hz : (SemiSSet.boundary d.n).ι ≫ attachCell X d.n (d.a ≫ f.hom) =
        d.a ≫ (f ≫ attachJ X d.n (d.a ≫ f.hom)).hom := by
      rw [attach_w, Category.assoc]; rfl
    obtain ⟨k, ⟨hk₁, hk₂⟩, -⟩ := d.univ P (f ≫ attachJ X d.n (d.a ≫ f.hom)) _ hz
    refine ⟨P, k, attachJ X d.n (d.a ≫ f.hom), ?_, fun hX => .attach _ hX
      (attach_isCellAttachment _ _ _), .of _ (Or.inl (attach_isCellAttachment _ _ _))⟩
    refine isPushout_of_universal hk₁ fun Z b x hbx => ?_
    have hz' : (SemiSSet.boundary d.n).ι ≫ d.y ≫ b.hom = (d.a ≫ f.hom) ≫ x.hom := by
      rw [← Category.assoc, d.w, Category.assoc, Category.assoc]
      exact congrArg (d.a ≫ ·) (congrArg AlgKan.Hom.hom hbx)
    obtain ⟨p, ⟨hp₁, hp₂⟩, -⟩ := (attachData X d.n (d.a ≫ f.hom)).univ Z x (d.y ≫ b.hom) hz'
    refine ⟨p, ⟨?_, hp₁⟩, ?_⟩
    · apply d.hom_ext
      · rw [← Category.assoc, hk₁, Category.assoc, hp₁, hbx]
      · change d.y ≫ k.hom ≫ p.hom = _
        rw [← Category.assoc, hk₂]
        exact hp₂
    · rintro p' ⟨h₁, h₂⟩
      apply (attachData X d.n (d.a ≫ f.hom)).hom_ext
      · rw [h₂, hp₁]
      · change attachCell X d.n (d.a ≫ f.hom) ≫ p'.hom = attachCell X d.n (d.a ≫ f.hom) ≫ p.hom
        erw [hp₂, ← hk₂]
        rw [Category.assoc]
        exact congrArg (d.y ≫ ·) (congrArg AlgKan.Hom.hom h₁)
  · have : IsIso i := hi
    refine ⟨X, inv i ≫ f, 𝟙 X, IsPushout.of_horiz_isIso ⟨by simp⟩, id, .id _⟩

/-- Pushouts along cellular maps of algebraic Kan complexes. -/
theorem exists_isPushout_of_cellular {A B : AlgKan.{u}} (i : A ⟶ B) (hi : AlgKan.cellularMaps i)
    {X : AlgKan.{u}} (f : A ⟶ X) :
    ∃ (P : AlgKan.{u}) (k : B ⟶ P) (j : X ⟶ P), IsPushout i f k j ∧
      (AlgKan.IsFinitelyCellular X → AlgKan.IsFinitelyCellular P) ∧ AlgKan.cellularMaps j := by
  induction hi generalizing X with
  | of i hi => exact exists_isPushout_of_cell i hi f
  | id A => exact ⟨X, f, 𝟙 X, IsPushout.of_horiz_isIso ⟨by simp⟩, id, .id _⟩
  | comp_of i₁ i₂ _ h₂ ih =>
    obtain ⟨P₁, k₁, j₁, sq₁, hP₁, hj₁⟩ := ih f
    obtain ⟨P₂, k₂, j₂, sq₂, hP₂, hj₂⟩ := exists_isPushout_of_cell i₂ h₂ k₁
    exact ⟨P₂, k₂, j₁ ≫ j₂, sq₁.paste_horiz sq₂, hP₂ ∘ hP₁,
      (MorphismProperty.multiplicativeClosure _).comp_mem _ _ hj₁ hj₂⟩

/-- A pushout square of algebraic Kan complexes between objects of `C^Δ` is a pushout in
`C^Δ`. -/
theorem isPushout_of_alg {A B X P : CDelta.{u}} {i : A ⟶ B} {f : A ⟶ X} {k : B ⟶ P} {j : X ⟶ P}
    (h : IsPushout i.hom f.hom k.hom j.hom) : IsPushout i f k j :=
  IsPushout.of_map (F := ObjectProperty.ι _) (ObjectProperty.hom_ext _ h.w) h

/-- **Pushouts along cofibrations of `C^Δ` are pushouts of algebraic Kan complexes.** -/
theorem isPushout_alg_of_isPushout {A B X P : CDelta.{u}} {i : A ⟶ B} {f : A ⟶ X} {k : B ⟶ P}
    {j : X ⟶ P} (h : IsPushout i f k j) (hi : cofibrations CDelta.{u} i) :
    IsPushout i.hom f.hom k.hom j.hom := by
  obtain ⟨P', k', j', sq, hP', -⟩ := exists_isPushout_of_cellular i.hom hi f.hom
  let Q : CDelta.{u} := ⟨P', hP' X.property⟩
  have sqC : IsPushout i f (ObjectProperty.homMk k' : B ⟶ Q) (ObjectProperty.homMk j') :=
    isPushout_of_alg sq
  let e := IsPushout.isoIsPushout _ _ h sqC
  exact sq.of_iso (Iso.refl _) (Iso.refl _) (Iso.refl _) ((ObjectProperty.ι _).mapIso e.symm)
    (by simp) (by simp)
    (by rw [Iso.refl_hom, Category.id_comp]
        exact congrArg (fun t => t.hom) (IsPushout.inl_isoIsPushout_inv _ _ h sqC))
    (by rw [Iso.refl_hom, Category.id_comp]
        exact congrArg (fun t => t.hom) (IsPushout.inr_isoIsPushout_inv _ _ h sqC))

/-- Pushouts along cofibrations exist in `C^Δ`. -/
theorem exists_isPushout_cdelta {A B : CDelta.{u}} (i : A ⟶ B) (hi : cofibrations CDelta.{u} i)
    {X : CDelta.{u}} (f : A ⟶ X) :
    ∃ (P : CDelta.{u}) (k : B ⟶ P) (j : X ⟶ P), IsPushout i f k j ∧ cofibrations CDelta.{u} j := by
  obtain ⟨P', k', j', sq, hP', hj'⟩ := exists_isPushout_of_cellular i.hom hi f.hom
  exact ⟨⟨P', hP' X.property⟩, ObjectProperty.homMk k', ObjectProperty.homMk j',
    isPushout_of_alg sq, hj'⟩

end Pushouts

section Free

/-- Freeness transported along an isomorphism of generators. -/
theorem isFreeOn_comp_iso {S S' : SemiSSet.{u}} {Y : AlgKan.{u}} {η : S ⟶ Y.X}
    (h : Y.IsFreeOn η) (e : S' ≅ S) : Y.IsFreeOn (e.hom ≫ η) := by
  intro Z z
  obtain ⟨g, hg, hu⟩ := h Z (e.inv ≫ z)
  refine ⟨g, ?_, fun g' hg' => hu g' ?_⟩ <;> dsimp only at *
  · rw [Category.assoc, hg, Iso.hom_inv_id_assoc]
  · rw [← hg', Category.assoc, Iso.inv_hom_id_assoc]

/-- Two objects free on the same generators are isomorphic. -/
noncomputable def isoOfIsFreeOn {S : SemiSSet.{u}} {Y Y' : AlgKan.{u}} {η : S ⟶ Y.X}
    {η' : S ⟶ Y'.X} (h : Y.IsFreeOn η) (h' : Y'.IsFreeOn η') : Y ≅ Y' where
  hom := (h Y' η').exists.choose
  inv := (h' Y η).exists.choose
  hom_inv_id := (h Y η).unique (by
      change η ≫ (_ ≫ _) = η
      rw [← Category.assoc, (h Y' η').exists.choose_spec,
        (h' Y η).exists.choose_spec]) (Category.comp_id η)
  inv_hom_id := (h' Y' η').unique (by
      change η' ≫ (_ ≫ _) = η'
      rw [← Category.assoc, (h' Y η).exists.choose_spec,
        (h Y' η').exists.choose_spec]) (Category.comp_id η')

theorem isoOfIsFreeOn_hom {S : SemiSSet.{u}} {Y Y' : AlgKan.{u}} {η : S ⟶ Y.X}
    {η' : S ⟶ Y'.X} (h : Y.IsFreeOn η) (h' : Y'.IsFreeOn η') :
    η ≫ (isoOfIsFreeOn h h').hom.hom = η' :=
  (h Y' η').exists.choose_spec

/-- The map from a semi-simplicial set without simplices to the empty one. -/
def toEmptyX {S : SemiSSet.{u}} (hS : ∀ d, IsEmpty (S.obj d)) : S ⟶ emptyX.{u} where
  app d := TypeCat.ofHom (fun s => ((hS d).false s).elim)
  naturality _ _ _ := by
    ext s
    exact ((hS _).false s).elim

/-- The empty algebraic Kan complex is free on an empty semi-simplicial set. -/
theorem isFreeOn_empty {S : SemiSSet.{u}} (hS : ∀ d, IsEmpty (S.obj d)) :
    emptyKan.IsFreeOn (toEmptyX hS) :=
  fun Z z => ⟨isInitial_emptyKan.to Z, by ext d s; exact ((hS d).false s).elim,
    fun _ _ => isInitial_emptyKan.hom_ext _ _⟩

/-- Attaching a cell to a free object along a pushout of generators gives a free object. -/
theorem isFreeOn_attach {S' S : SemiSSet.{u}} {m : ℕ} {b : (SemiSSet.boundary.{u} m).toFunctor ⟶ S'}
    {incl : S' ⟶ S} {σ : SemiSSet.stdSimplex.obj (Henry.SemiSimplexCategory.mk m) ⟶ S}
    (hP : IsPushout b (SemiSSet.boundary.{u} m).ι incl σ) {Y' : AlgKan.{u}} {η' : S' ⟶ Y'.X}
    (h' : Y'.IsFreeOn η') :
    (attach Y' m (b ≫ η')).IsFreeOn (hP.desc (η' ≫ (attachJ Y' m (b ≫ η')).hom)
      (attachCell Y' m (b ≫ η')) (by rw [← Category.assoc, attach_w])) := by
  intro Z z
  obtain ⟨g₀, hg₀, hu₀⟩ := h' Z (incl ≫ z)
  have hz : (SemiSSet.boundary m).ι ≫ σ ≫ z = (b ≫ η') ≫ g₀.hom := by
    rw [← Category.assoc, ← hP.w, Category.assoc, Category.assoc, hg₀]
  obtain ⟨g, ⟨hg₁, hg₂⟩, -⟩ := (attachData Y' m (b ≫ η')).univ Z g₀ (σ ≫ z) hz
  refine ⟨g, ?_, fun g' hg' => ?_⟩
  · apply hP.hom_ext
    · rw [hP.inl_desc_assoc, Category.assoc]
      change η' ≫ (attachJ Y' m (b ≫ η') ≫ g).hom = _
      rw [hg₁, hg₀]
    · rw [hP.inr_desc_assoc]
      exact hg₂
  · dsimp only at hg'
    apply (attachData Y' m (b ≫ η')).hom_ext
    · rw [hg₁]
      apply hu₀
      change η' ≫ (attachJ Y' m (b ≫ η')).hom ≫ g'.hom = incl ≫ z
      rw [← hg', ← Category.assoc incl, hP.inl_desc, Category.assoc]
    · have e1 : attachCell Y' m (b ≫ η') = σ ≫ hP.desc (η' ≫ (attachJ Y' m (b ≫ η')).hom)
          (attachCell Y' m (b ≫ η')) (by rw [← Category.assoc, attach_w]) :=
        (hP.inr_desc _ _ _).symm
      change attachCell Y' m (b ≫ η') ≫ g'.hom = attachCell Y' m (b ≫ η') ≫ g.hom
      calc attachCell Y' m (b ≫ η') ≫ g'.hom
          = σ ≫ hP.desc (η' ≫ (attachJ Y' m (b ≫ η')).hom) (attachCell Y' m (b ≫ η'))
            (by rw [← Category.assoc, attach_w]) ≫ g'.hom := by
              rw [← Category.assoc, ← e1]
        _ = σ ≫ z := by rw [hg']
        _ = attachCell Y' m (b ≫ η') ≫ g.hom := hg₂.symm

/-- Induction over the semi-simplicial subsets of standard simplices, attaching one top simplex
at a time. -/
theorem subfunctor_induction
    (Q : ∀ N : ℕ, Subfunctor (SemiSSet.stdSimplex.{u}.obj (Henry.SemiSimplexCategory.mk N)) → Prop)
    (h0 : ∀ N S, (∀ d, IsEmpty (S.obj d)) → Q N S)
    (hstep : ∀ (N : ℕ) (S S' : Subfunctor (SemiSSet.stdSimplex.{u}.obj
        (Henry.SemiSimplexCategory.mk N))) (hle : S' ≤ S) (m : ℕ)
      (b : (SemiSSet.boundary.{u} m).toFunctor ⟶ S'.toFunctor)
      (σ : SemiSSet.stdSimplex.{u}.obj (Henry.SemiSimplexCategory.mk m) ⟶ S.toFunctor),
      IsPushout b (SemiSSet.boundary.{u} m).ι (Subfunctor.homOfLe hle) σ →
      Q N S' → Q m (SemiSSet.boundary.{u} m) → Q N S) :
    ∀ N S, Q N S := by
  suffices H : ∀ c N S, simplexCount.{u} S.toFunctor N = c → Q N S from
    fun N S => H _ N S rfl
  intro c
  induction c using Nat.strong_induction_on with
  | _ c ih =>
    intro N S hc
    by_cases hS : ∃ d, (S.obj d).Nonempty
    · obtain ⟨m, S', hle, b, σ, sq, h₁, h₂⟩ := Approximation.TopSimplex.exists_topSimplex_pushout_proof S hS
      exact hstep N S S' hle m b σ sq (ih _ (hc ▸ h₁) N S' rfl) (ih _ (hc ▸ h₂) m _ rfl)
    · refine h0 N S fun d => ⟨fun s => hS ⟨d, s.1, s.2⟩⟩

/-- Every semi-simplicial subset of a standard simplex freely generates an object of `C^Δ`. -/
theorem exists_free_subfunctor (N : ℕ)
    (S : Subfunctor (SemiSSet.stdSimplex.{u}.obj (Henry.SemiSimplexCategory.mk N))) :
    ∃ (Y : CDelta.{u}) (η : S.toFunctor ⟶ Y.obj.X), Y.obj.IsFreeOn η := by
  refine subfunctor_induction (fun N S => ∃ (Y : CDelta.{u}) (η : S.toFunctor ⟶ Y.obj.X),
    Y.obj.IsFreeOn η) (fun N S hS => ⟨emptyC, _, isFreeOn_empty hS⟩) ?_ N S
  rintro N S S' hle m b σ sq ⟨Y', η', h'⟩ -
  exact ⟨⟨attach Y'.obj m (b ≫ η'), .attach _ Y'.property (attach_isCellAttachment _ _ _)⟩, _,
    isFreeOn_attach sq h'⟩

/-- The whole standard simplex as a semi-simplicial subset of itself. -/
noncomputable def topIso (n : ℕ) :
    (⊤ : Subfunctor (SemiSSet.stdSimplex.{u}.obj (Henry.SemiSimplexCategory.mk n))).toFunctor ≅
      SemiSSet.stdSimplex.{u}.obj (Henry.SemiSimplexCategory.mk n) := by
  have : IsIso (⊤ : Subfunctor (SemiSSet.stdSimplex.{u}.obj
      (Henry.SemiSimplexCategory.mk n))).ι := by
    rw [NatTrans.isIso_iff_isIso_app]
    intro d
    rw [isIso_iff_bijective]
    exact ⟨fun x y h => Subtype.ext h, fun x => ⟨⟨x, trivial⟩, rfl⟩⟩
  exact asIso (⊤ : Subfunctor _).ι

/-- Free objects on simplices exist in `C^Δ`. -/
theorem exists_free_simplex (n : ℕ) :
    ∃ (Y : CDelta.{u}) (η : SemiSSet.stdSimplex.{u}.obj (Henry.SemiSimplexCategory.mk n) ⟶
      Y.obj.X), Y.obj.IsFreeOn η := by
  obtain ⟨Y, η, h⟩ := exists_free_subfunctor.{u} n ⊤
  exact ⟨Y, _, isFreeOn_comp_iso h (topIso n).symm⟩

/-- Free objects on simplex boundaries exist in `C^Δ`. -/
theorem exists_free_boundary (n : ℕ) :
    ∃ (Y : CDelta.{u}) (η : (SemiSSet.boundary.{u} n).toFunctor ⟶ Y.obj.X), Y.obj.IsFreeOn η :=
  exists_free_subfunctor.{u} n _

theorem isFreeOn_hom_ext {S : SemiSSet.{u}} {Y Z : AlgKan.{u}} {η : S ⟶ Y.X}
    (h : Y.IsFreeOn η) {g g' : Y ⟶ Z} (e : η ≫ g.hom = η ≫ g'.hom) : g = g' :=
  (h Z (η ≫ g.hom)).unique rfl e.symm

/-- A cell attachment is the pushout of the free map on `∂Δ_n ↪ Δ_n` along the attaching map. -/
theorem CellData.isPushout {X Y : AlgKan.{u}} {j : X ⟶ Y} (d : CellData j) {B D : AlgKan.{u}}
    {ηB : (SemiSSet.boundary.{u} d.n).toFunctor ⟶ B.X}
    {ηD : SemiSSet.stdSimplex.obj (Henry.SemiSimplexCategory.mk d.n) ⟶ D.X}
    (hB : B.IsFreeOn ηB) (hD : D.IsFreeOn ηD) {ι : B ⟶ D}
    (hι : ηB ≫ ι.hom = (SemiSSet.boundary d.n).ι ≫ ηD) {abar : B ⟶ X} (habar : ηB ≫ abar.hom = d.a)
    {ybar : D ⟶ Y} (hybar : ηD ≫ ybar.hom = d.y) : IsPushout ι abar ybar j := by
  have w : ι ≫ ybar = abar ≫ j := isFreeOn_hom_ext hB (by
    change ηB ≫ ι.hom ≫ ybar.hom = ηB ≫ abar.hom ≫ j.hom
    rw [← Category.assoc, hι, Category.assoc, hybar, ← Category.assoc, habar, d.w])
  refine isPushout_of_universal w fun Z b x hbx => ?_
  have hz : (SemiSSet.boundary d.n).ι ≫ ηD ≫ b.hom = d.a ≫ x.hom := by
    rw [← Category.assoc, ← hι, ← habar, Category.assoc, Category.assoc]
    exact congrArg (ηB ≫ ·) (congrArg AlgKan.Hom.hom hbx)
  obtain ⟨g, ⟨hg₁, hg₂⟩, hu⟩ := d.univ Z x (ηD ≫ b.hom) hz
  refine ⟨g, ⟨isFreeOn_hom_ext hD ?_, hg₁⟩, fun g' ⟨h₁, h₂⟩ => hu g' ⟨h₂, ?_⟩⟩
  · change ηD ≫ ybar.hom ≫ g.hom = _
    rw [← Category.assoc, hybar, hg₂]
  · rw [← hybar, Category.assoc]
    exact congrArg (ηD ≫ ·) (congrArg AlgKan.Hom.hom h₁)

/-- Free algebraic Kan complexes send pushouts of generators to pushouts. -/
theorem isPushout_of_free {S₀ S₁ S₂ S : SemiSSet.{u}} {b : S₀ ⟶ S₁} {l : S₀ ⟶ S₂}
    {incl : S₁ ⟶ S} {σ : S₂ ⟶ S} (sq : IsPushout b l incl σ) {Y₀ Y₁ Y₂ Y : AlgKan.{u}}
    {η₀ : S₀ ⟶ Y₀.X} {η₁ : S₁ ⟶ Y₁.X} {η₂ : S₂ ⟶ Y₂.X} {η : S ⟶ Y.X}
    (h₀ : Y₀.IsFreeOn η₀) (h₁ : Y₁.IsFreeOn η₁) (h₂ : Y₂.IsFreeOn η₂) (h : Y.IsFreeOn η)
    {β : Y₀ ⟶ Y₁} {ι : Y₀ ⟶ Y₂} {ι' : Y₁ ⟶ Y} {ybar : Y₂ ⟶ Y}
    (hβ : η₀ ≫ β.hom = b ≫ η₁) (hι : η₀ ≫ ι.hom = l ≫ η₂) (hι' : η₁ ≫ ι'.hom = incl ≫ η)
    (hy : η₂ ≫ ybar.hom = σ ≫ η) : IsPushout β ι ι' ybar := by
  have w : β ≫ ι' = ι ≫ ybar := isFreeOn_hom_ext h₀ (by
    change η₀ ≫ β.hom ≫ ι'.hom = η₀ ≫ ι.hom ≫ ybar.hom
    rw [← Category.assoc, hβ, Category.assoc, hι', ← Category.assoc, sq.w, ← Category.assoc η₀,
      hι, Category.assoc, Category.assoc, hy])
  refine isPushout_of_universal w fun Z x d hxd => ?_
  have hz : b ≫ η₁ ≫ x.hom = l ≫ η₂ ≫ d.hom := by
    rw [← Category.assoc, ← hβ, ← Category.assoc, ← hι, Category.assoc, Category.assoc]
    exact congrArg (η₀ ≫ ·) (congrArg AlgKan.Hom.hom hxd)
  obtain ⟨p, hp, -⟩ := h Z (sq.desc _ _ hz)
  have hp₁ : ι' ≫ p = x := isFreeOn_hom_ext h₁ (by
    change η₁ ≫ ι'.hom ≫ p.hom = _
    rw [← Category.assoc, hι', Category.assoc, hp, sq.inl_desc])
  have hp₂ : ybar ≫ p = d := isFreeOn_hom_ext h₂ (by
    change η₂ ≫ ybar.hom ≫ p.hom = _
    rw [← Category.assoc, hy, Category.assoc, hp, sq.inr_desc])
  refine ⟨p, ⟨hp₁, hp₂⟩, fun p' ⟨h₁', h₂'⟩ => isFreeOn_hom_ext h ?_⟩
  rw [hp]
  apply sq.hom_ext
  · rw [sq.inl_desc, ← Category.assoc, ← hι', Category.assoc, ← h₁']
    rfl
  · rw [sq.inr_desc, ← Category.assoc, ← hy, Category.assoc, ← h₂']
    rfl

end Free

end HomotopyHypothesis.Realization.SemisimplicialComparison
